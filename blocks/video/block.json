{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "imagina/video-player",
	"version": "1.31.0",
	"title": "Imagina Video Player",
	"category": "media",
	"icon": "format-video",
	"description": "A light video player with chapters, subtitles, calls to action and protected files.",
	"keywords": [
		"video",
		"mp4",
		"hls",
		"stream",
		"course",
		"lesson",
		"webinar",
		"player"
	],
	"textdomain": "imagina-player",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": {
			"clientNavigation": false
		}
	},
	"editorScript": "imagina-player-editor",
	"editorStyle": "imagina-player-editor",
	"style": "imagina-player",
	"viewScript": "imagina-player"
}
