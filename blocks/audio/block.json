{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "imagina/audio-player",
	"version": "1.50.0",
	"title": "Imagina Audio Player",
	"category": "media",
	"icon": "format-audio",
	"description": "A fast waveform audio player with reusable presets.",
	"keywords": [ "audio", "mp3", "waveform", "podcast", "music", "player" ],
	"textdomain": "imagina-player",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": {
			"clientNavigation": false
		}
	},
	"example": {
		"attributes": {
			"src": "https://example.com/episode-12.mp3",
			"title": "Episode 12: Making things small",
			"artist": "Imagina"
		}
	},
	"editorScript": "imagina-player-editor",
	"editorStyle": "imagina-player-editor",
	"viewScript": "imagina-player"
}
