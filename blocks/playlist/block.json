{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "imagina/playlist",
	"version": "1.30.0",
	"title": "Imagina Playlist",
	"category": "media",
	"icon": "playlist-audio",
	"description": "Several tracks in one player, as a list or a grid.",
	"keywords": [ "playlist", "album", "series", "course", "podcast" ],
	"textdomain": "imagina-player",
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": {
			"clientNavigation": false
		}
	},
	"editorScript": "imagina-player-editor",
	"editorStyle": "imagina-player-editor",
	"style": "imagina-player",
	"viewScript": "imagina-player"
}
