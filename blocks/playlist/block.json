{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "imagina/playlist",
	"version": "1.50.0",
	"title": "Imagina Playlist",
	"category": "media",
	"icon": "list-view",
	"description": "Several tracks or videos in one player: a list, a grid of covers, or a video with its lessons beside it, under it or in a slider.",
	"keywords": [ "playlist", "album", "series", "course", "podcast" ],
	"textdomain": "imagina-player",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		},
		"interactivity": {
			"clientNavigation": false
		}
	},
	"example": {
		"attributes": {
			"heading": "Season one",
			"items": [
				{ "src": "https://example.com/one.mp3", "title": "One: Where it starts" },
				{ "src": "https://example.com/two.mp3", "title": "Two: The long middle" },
				{ "src": "https://example.com/three.mp3", "title": "Three: How it ends" }
			]
		}
	},
	"editorScript": "imagina-player-editor",
	"editorStyle": "imagina-player-editor",
	"viewScript": "imagina-player"
}
