#. translators: %s: HTTP status the remote server returned.
#: assets/src/editor/waveform-notice.tsx:302
msgid "the address does not return an audio or video file"
msgstr "la dirección no devuelve un archivo de audio ni de vídeo"

#: assets/src/editor/waveform-notice.tsx:392
