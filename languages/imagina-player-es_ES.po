#: assets/src/shared/failure.ts:186
msgid "something between the browser and WordPress answered %s — this plugin did not, because every refusal it makes says why. Settings → Imagina Player → Waveforms has a check that asks the server directly and reports what it finds."
msgstr "algo entre el navegador y WordPress respondió %s; este plugin no fue, porque todos sus rechazos dicen el motivo. En Ajustes → Imagina Player → Ondas hay una comprobación que le pregunta al servidor directamente e informa de lo que encuentra."

#: assets/src/shared/failure.ts:130
msgid "that address was refused as unsafe to fetch"
msgstr "esa dirección se rechazó por no ser segura de descargar"

#. translators: %s: HTTP status the remote server returned.
#: assets/src/shared/failure.ts:89
msgid "the address does not return an audio or video file"
msgstr "la dirección no devuelve un archivo de audio ni de vídeo"

#: assets/src/shared/failure.ts:220
msgid "the browser could not decode it — check that the file plays"
msgstr "el navegador no lo pudo descodificar; comprueba que el archivo se reproduce"

#: assets/src/shared/failure.ts:253
msgid "the browser could not read it, which is usually a cross-origin refusal"
msgstr "el navegador no lo pudo leer, que suele ser un rechazo por origen cruzado"

#. translators: %s: HTTP status code, or "?" when there was none.
#: assets/src/shared/failure.ts:205
msgid "the download stopped early — the file may be behind something that cuts long transfers off"
msgstr "la descarga se cortó antes de tiempo; puede que el archivo esté detrás de algo que corta las transferencias largas"

#: assets/src/shared/failure.ts:96
msgid "the file is larger than this site will fetch on your behalf"
msgstr "el archivo es más grande de lo que este sitio descarga por ti"

#: assets/src/shared/failure.ts:116
msgid "the file is on this site, so the browser reads it directly — if that failed, the file itself could not be read"
msgstr "el archivo está en este sitio, así que el navegador lo lee directamente; si eso falló, no se pudo leer el propio archivo"

#. translators: %s: HTTP status code, or "?" when there was none.
#: assets/src/shared/failure.ts:196
msgid "the server answered %s when asked for the file"
msgstr "el servidor respondió %s al pedirle el archivo"

#. translators: %s: HTTP status the remote server returned.
#: assets/src/shared/failure.ts:80
msgid "the server hosting the file answered %s to this site as well — check that domain’s hotlink protection or signed-link rules"
msgstr "el servidor donde está el archivo también le respondió %s a este sitio; revisa la protección contra enlazado o las reglas de enlaces firmados de ese dominio"

#: assets/src/shared/failure.ts:239
msgid "the server sent nothing back for part of the file"
msgstr "el servidor no devolvió nada para una parte del archivo"

#: assets/src/shared/failure.ts:211
msgid "this browser cannot decode audio"
msgstr "este navegador no puede descodificar audio"

#: assets/src/shared/failure.ts:109
msgid "this site could not open a temporary file to download into — check the server’s free disk space and that the uploads folder is writable"
msgstr "este sitio no pudo crear el archivo temporal donde descargar; revisa el espacio libre en disco del servidor y que la carpeta de subidas tenga permiso de escritura"

#. translators: %s: what the HTTP client reported, verbatim.
#: src/Media/Providers/VimeoThumbnail.php:417
msgid "this site could not reach Vimeo — %s"
msgstr "este sitio no pudo llegar a Vimeo: %s"

#: assets/src/shared/failure.ts:72
msgid "this site could not reach the file’s own server"
msgstr "este sitio no pudo llegar al servidor donde está el archivo"

#: assets/src/shared/failure.ts:144
msgid "this site refused the request that fetches the file — reload the editor and try again"
msgstr "este sitio rechazó la petición que descarga el archivo; recarga el editor e inténtalo de nuevo"

#: assets/src/shared/failure.ts:177
msgid "this site refused to fetch the file and the reason did not survive the trip — Settings → Imagina Player → Waveforms has a check that asks the server directly and reports it"
msgstr "este sitio rechazó descargar el archivo y el motivo se perdió por el camino; en Ajustes → Imagina Player → Ondas hay una comprobación que se lo pregunta al servidor directamente y lo informa"

#: assets/src/shared/failure.ts:123
msgid "too many files were fetched in the last few minutes — wait a little and try again"
msgstr "se pidieron demasiados archivos en los últimos minutos; espera un poco y vuelve a intentarlo"

